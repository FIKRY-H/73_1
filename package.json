{
  "name": "webbattery-test-suite",
  "version": "1.0.0",
  "description": "WebBattery testing and simulation suite",
  "main": "device_simulator.js",
  "scripts": {
    "test": "node comprehensive_test_suite.js",
    "test:comprehensive": "node comprehensive_test_suite.js",
    "test:quick": "node quick_test.js",
    "regression:protocol": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/protocol_regression_check.ps1",
    "regression:protocol:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/protocol_regression_check.ps1 -RunBuild",
    "start-devices": "node start_device_simulators.bat",
    "auto-fix": "node auto_bug_fixer.js",
    "build": "cd webbattery_server && npm run build && cd ../webbattery_client && npm run build",
    "build:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-all.ps1"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "modbus-serial": "^8.0.17",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "webbattery",
    "testing",
    "simulation",
    "modbus",
    "websocket"
  ],
  "author": "WebBattery Team",
  "license": "MIT"
}